# Exact versions only — AGENTS.md section 11 requires pinned dependencies.
save-exact=true
save-prefix=
# Catch phantom dependencies: a package must declare what it imports.
strict-peer-dependencies=false
# Warning: this makes a peerDependency an ordinary dependency, which `--prod` then installs into
# the service images. Never peer-depend on build or test tooling — put it in devDependencies.
# (shared/test/image-prod-deps.test.ts enforces this; a peer on vitest once shipped the whole
# vitest closure into the hooks, voice and workers images and failed their trivy scan.)
auto-install-peers=true
# Refuse to run on a Node version the project does not support.
engine-strict=true
