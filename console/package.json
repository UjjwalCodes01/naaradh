{
  "name": "@naaradh/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "comment": "Naaradh staff console (console.naaradh.com, behind IAP only). Server-rendered HTML over the SERVICE role: complaint review, tenant resume/suspend, dispute decisions, erasure and DNC filing, kill switches. Every action audited as staff:<email>.",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env.local --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@google-cloud/storage": "8.2.0",
    "@naaradh/calendar": "workspace:*",
    "@naaradh/compliance": "workspace:*",
    "@naaradh/db": "workspace:*",
    "@naaradh/pipeline": "workspace:*",
    "@naaradh/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "ioredis": "5.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13"
  }
}
