{
  "name": "@naaradh/shopify-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "comment": "Embedded Shopify app (ADR-0007): React Router template, Polaris web components, App Bridge. Onboarding, settings, billing approval. Sessions encrypted in Postgres through SECURITY DEFINER functions (ADR-0009); webhooks go to apps/hooks. The third-party deps of the bundled workspace packages are listed here so Vite keeps them external (node_modules at runtime).",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "shopify": "shopify"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@naaradh/compliance": "workspace:*",
    "@naaradh/db": "workspace:*",
    "@naaradh/pipeline": "workspace:*",
    "@naaradh/scripts": "workspace:*",
    "@naaradh/shared": "workspace:*",
    "@naaradh/shopify-sdk": "workspace:*",
    "@react-router/node": "7.18.3",
    "@react-router/serve": "7.18.3",
    "@shopify/app-bridge-react": "4.2.13",
    "@shopify/shopify-api": "13.1.0",
    "@shopify/shopify-app-react-router": "1.2.1",
    "@shopify/shopify-app-session-storage": "6.0.1",
    "drizzle-orm": "0.44.7",
    "ioredis": "5.6.1",
    "isbot": "5.2.2",
    "libphonenumber-js": "1.13.13",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3",
    "ulid": "2.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.3",
    "@react-router/fs-routes": "7.18.3",
    "@shopify/polaris-types": "1.0.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1"
  }
}
