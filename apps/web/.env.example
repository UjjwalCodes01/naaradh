# ---------------------------------------------------------------------------
# apps/web on Vercel — the MARKETING site (naaradh.com)
#
# Paste these into Vercel → Project → Settings → Environment Variables, for both Production
# and Preview. That is the whole list: the marketing pages read no database, no Redis and no
# key, so this deployment holds no credential at all (docs/go-live/11-marketing-site-vercel.md).
#
# The merchant dashboard is the same codebase with NAARADH_SURFACE unset (`full`), deployed to
# Cloud Run instead — it needs Memorystore Redis, which is private to the GCP VPC and cannot be
# reached from Vercel. Its variables are in the repo root .env.example and `pnpm env:list web`.
# ---------------------------------------------------------------------------

# Serve the marketing pages only. Sign-in, /app, /do-not-call and /api are NOT served here;
# they redirect to DASHBOARD_URL (404 while that deployment does not exist yet).
NAARADH_SURFACE=marketing

# The dashboard's own origin, for those redirects and for links in the page footer.
DASHBOARD_URL=https://app.naaradh.com

# Vercel sets NODE_ENV=production on Production and Preview builds; nothing to add.
# VERCEL_ENV is Vercel's own: on `preview` the site tells crawlers to stay away (robots.ts).
