{
  "name": "@naaradh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src test",
    "openapi": "node -e \"console.error('openapi generation from the zod route schemas is P1-API docs work; see apps/api/src/routes/*.ts for the contracts'); process.exit(1)\""
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@google-cloud/secret-manager": "6.1.1",
    "@google-cloud/storage": "8.1.0",
    "@naaradh/compliance": "workspace:*",
    "@naaradh/db": "workspace:*",
    "@naaradh/payments": "workspace:*",
    "@naaradh/pipeline": "workspace:*",
    "@naaradh/scripts": "workspace:*",
    "@naaradh/shared": "workspace:*",
    "@naaradh/shopify-sdk": "workspace:*",
    "drizzle-orm": "0.44.7",
    "fastify": "5.2.1",
    "ioredis": "5.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2"
  }
}
