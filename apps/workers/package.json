{
  "name": "@naaradh/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "rotate:shopify-token-key": "node --import tsx src/maintenance/rotate-shopify-token-key.ts",
    "rotate:phone-enc-key": "node --import tsx src/maintenance/rotate-phone-enc-key.ts",
    "rotate:staff-enc-key": "node --import tsx src/maintenance/rotate-staff-enc-key.ts",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.0.3",
    "@google-cloud/pubsub": "6.0.1",
    "@google-cloud/secret-manager": "6.1.1",
    "@google-cloud/storage": "8.1.0",
    "@naaradh/calendar": "workspace:*",
    "@naaradh/compliance": "workspace:*",
    "@naaradh/db": "workspace:*",
    "@naaradh/engines-core": "workspace:*",
    "@naaradh/engines-registry": "workspace:*",
    "@naaradh/notify": "workspace:*",
    "@naaradh/payments": "workspace:*",
    "@naaradh/pipeline": "workspace:*",
    "@naaradh/scripts": "workspace:*",
    "@naaradh/shared": "workspace:*",
    "@naaradh/shopify-sdk": "workspace:*",
    "drizzle-orm": "0.44.7",
    "ioredis": "6.0.0",
    "luxon": "3.7.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@naaradh/engine-simulator": "workspace:*",
    "@testcontainers/redis": "12.1.0",
    "@types/luxon": "3.7.5",
    "tsup": "8.3.5",
    "tsx": "4.19.2"
  }
}
