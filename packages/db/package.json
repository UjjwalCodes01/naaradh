{
  "name": "@naaradh/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./service": "./src/service.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "generate:custom": "drizzle-kit generate --custom",
    "migrate": "node --env-file-if-exists=../../.env.local --import tsx src/migrate-cli.ts",
    "seed": "node --env-file-if-exists=../../.env.local --import tsx src/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@naaradh/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
