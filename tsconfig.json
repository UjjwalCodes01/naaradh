{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "*/src/**/*.ts",
    "*/test/**/*.ts",
    "engines/*/src/**/*.ts",
    "engines/*/test/**/*.ts",
    "engines/*/src/**/*.ts",
    "engines/*/test/**/*.ts",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "*/tsup.config.ts",
    "*/drizzle.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "web/**", "shopify/**"]
}
