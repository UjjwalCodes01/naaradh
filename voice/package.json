{
  "name": "@naaradh/voice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "comment": "voice.naaradh.com — the synchronous runtime for two-way calls (ADR-0006): inbound context (who answers, with what) and mid-call tools. Holds the customer PUBLIC key and the STAFF private key only.",
