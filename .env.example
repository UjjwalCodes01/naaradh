# Copy to .env.local (git-ignored) and fill in. NEVER commit a filled-in file.
# Production values live in Secret Manager and are mounted by Cloud Run.
# Variable names are the contract (CLAUDE.md "Environment variables"); values here are
# local-only throwaways that match docker-compose.yml.

# ---------------------------------------------------------------------------
# Local services (docker compose up -d --wait)
# ---------------------------------------------------------------------------
# Host ports are 55432 / 56379, not the defaults, so these never collide with a Postgres or
# Redis already installed on the machine (see docker-compose.yml).
#
# Three roles, three URLs (ADR-0004, docs/runbooks/neon-bootstrap.md):
#   naaradh_app      NOBYPASSRLS — api, shopify, tenant-scoped workers. Every query via withTenant().
#   naaradh_service  BYPASSRLS   — hooks + cross-tenant workers ONLY (reconcile, retention, billing-meter, complaints).
#   naaradh_migrator owner       — migrations only. On Neon: the DIRECT endpoint, never the -pooler one.
DATABASE_URL=postgres://naaradh_app:local_dev_only@localhost:55432/naaradh_dev
DATABASE_SERVICE_URL=postgres://naaradh_service:local_dev_only@localhost:55432/naaradh_dev
DATABASE_MIGRATOR_URL=postgres://naaradh_migrator:local_dev_only@localhost:55432/naaradh_dev
REDIS_URL=redis://localhost:56379
PUBSUB_EMULATOR_HOST=localhost:8085

# ---------------------------------------------------------------------------
# GCP
# ---------------------------------------------------------------------------
GCP_PROJECT=naaradh-local
GCP_REGION=asia-south1
# The data region this deployment serves (ADR-0012). One deployment, one region: the gate,
# inbound admission and every cross-tenant sweep refuse a tenant whose data_region differs.
# in | us | eu
DATA_REGION=in
RECORDINGS_BUCKET=

# ---------------------------------------------------------------------------
# Crypto — invariant 8. Generate all three with: pnpm keys:dev  (prints, never writes)
#
# PHONE_HASH_KEY        HMAC-SHA256 key for phone_hash. Stable per environment: rotating it
#                       orphans every suppression and consent row, so rotation is a re-hash
#                       migration, not a config change. Every service has it.
# PHONE_ENC_PUBLIC_KEY  RSA-OAEP public key (PEM). Ingestion services (api, intents-consumer,
#                       hooks) hold ONLY this: they can encrypt a number, never read one back.
# PHONE_ENC_PRIVATE_KEY RSA-OAEP private key (PEM). Mounted ONLY into the dispatcher and the
#                       results-consumer. In production it lives in KMS/Secret Manager.
# PHONE_ENC_KID         Key version stamped on each ciphertext for rotation.
#
# Multi-line PEMs in a .env file: wrap in double quotes with literal \n, e.g.
#   PHONE_ENC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"
# ---------------------------------------------------------------------------
PHONE_HASH_KEY=
PHONE_ENC_PUBLIC_KEY=
PHONE_ENC_PRIVATE_KEY=
PHONE_ENC_KID=1

# Staff key pair (ADR-0006, invariant 19) — merchant staff numbers: transfer targets and the
# fallback line. The api/seed hold the PUBLIC half; voice holds the PRIVATE half so it can
# hand a verified manager's number to the engine. voice must NEVER hold PHONE_ENC_PRIVATE_KEY
# in production (it refuses to boot there). Generate with: pnpm keys:dev
STAFF_ENC_PUBLIC_KEY=
STAFF_ENC_PRIVATE_KEY=
STAFF_ENC_KID=1

# ---------------------------------------------------------------------------
# Shopify app (shopify, pnpm dev:shopify — ADR-0007) + the workers that call the Admin API
#
# `shopify app dev` INJECTS SHOPIFY_API_KEY (the app's Client ID), SHOPIFY_API_SECRET and
# SHOPIFY_APP_URL (the tunnel) itself, so leave them blank for local work: the embedded app
# boots under the CLI, not from this file alone. In a deployment they come from Secret Manager
# and the hostnames in the tfvars (go-live 04).
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# 32 random bytes, base64 — seals offline tokens in shopify_sessions (AES-256-GCM). Held by
# shopify and workers writebacks/actions/billing/reconcile. Generate: openssl rand -base64 32
SHOPIFY_TOKEN_KEY=
SHOPIFY_TOKEN_KID=1
# During a SHOPIFY_TOKEN_KEY rotation only (docs/runbooks/secret-rotation.md): the retiring key.
SHOPIFY_TOKEN_KEY_PREVIOUS=
SHOPIFY_TOKEN_KID_PREVIOUS=
# Test charges for the Shopify Billing API (dev stores, staging). Default: true outside production.
SHOPIFY_BILLING_TEST=true
# Scopes come from shopify-sdk/src/scopes.ts. Override ONLY to test a scope change:
# SCOPES=
# Admin GraphQL version for order write-backs (P1-SHOP-2). Bump with docs/runbooks (quarterly).
SHOPIFY_ADMIN_API_VERSION=2026-07
# live = write tags/notes/metafields/cancels to the merchant's store; recording = only record the
# plan. Default: live in production, recording everywhere else (dev/CI never touch a real store).
SHOPIFY_WRITEBACK=recording
# Fire the Shopify Flow trigger "Naaradh call completed" after each write-back. Turn on once
# the trigger extension has been released with `shopify app deploy` (go-live 04).
SHOPIFY_FLOW_TRIGGER=false

# ---------------------------------------------------------------------------
# Voice engines: simulator | bolna | omnidim | retell. Which Indian engine is primary is
# ADR-0001's decision (bake-off, P0-ENG-6); both adapters exist so the bake-off runs through
# Naaradh. Local and CI default to the simulator so no real call is ever placed from a dev box.
# Choosing an engine without its API key fails at boot.
# ---------------------------------------------------------------------------
ENGINE_DEFAULT_IN=simulator
ENGINE_DEFAULT_US=simulator
ENGINE_SECONDARY_IN=
# Failover engine for +1/+44 recipients (unset = none).
ENGINE_SECONDARY_US=
SIMULATOR_WEBHOOK_SECRET=local_dev_only_simulator_secret
BOLNA_API_KEY=
# Bolna signs nothing: this bearer (≥ 32 random chars: openssl rand -hex 32) is what its agent
# presents when it calls our tools or asks who is calling. Unset → Bolna agents get no tools.
BOLNA_TOOL_TOKEN=
# Support line on Bolna: off until seen working on a real call (go-live 03, Q-34).
BOLNA_INBOUND=false
# The telephony account connected to Bolna: plivo | exotel | twilio | vobiz | sip-trunk
BOLNA_TELEPHONY_PROVIDER=
# provider/model behind Bolna agents, e.g. openai/gpt-4.1-mini
BOLNA_LLM=
# Voice per locale, from Bolna's "List voices": {"hi-IN":{"provider":"sarvam","voice":"…","voice_id":"…","model":"bulbul:v3","language":"hi"}}
BOLNA_VOICES=
OMNIDIM_API_KEY=
# Voice per locale, from OmniDimension's voices list: {"hi-IN":{"provider":"sarvam","voice_id":"…"}}
OMNIDIM_VOICES=
OMNIDIM_MODEL=
RETELL_API_KEY=
# Retell voice per locale as JSON, e.g. {"en-US":"11labs-…"}; model for the Retell LLM.
RETELL_VOICES={}
RETELL_MODEL=
# Binds each engine webhook URL to one tenant (shared/signing.ts). From: pnpm keys:dev
ENGINE_WEBHOOK_KEY=
# Where engines POST call events. Locally the hooks service on :3002.
HOOKS_BASE_URL=http://localhost:3002
# Where engines ask "who answers?" and call mid-call tools (voice). Locally :3003.
# Configure every inbound number's answer URL as ${VOICE_BASE_URL}/inbound/<vendor>.
VOICE_BASE_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# Workers (workers). WORKER selects the role: intents | dispatcher | results | reconcile | deliveries | actions | writebacks | complaints | retention | billing | notifications | all
# Only dispatcher/results/reconcile may hold PHONE_ENC_PRIVATE_KEY in production (AGENTS §4).
# ---------------------------------------------------------------------------
WORKER=all
PUBSUB_TOPIC_PREFIX=naaradh
DISPATCH_BATCH=10
DISPATCH_POLL_MS=1000
# How often reconcile sweeps stuck attempts, uncertain dispatches and the registries.
RECONCILE_INTERVAL_MS=60000
ENGINE_MAX_CONCURRENCY=20
ENGINE_DAILY_CAP_PAISE=5000000
GLOBAL_DAILY_CAP_PAISE=20000000
# Dollar spend caps for US/EU engines (P6), in cents. Kept per currency, never converted.
ENGINE_DAILY_CAP_USD_CENTS=60000
GLOBAL_DAILY_CAP_USD_CENTS=240000
# Regions whose national do-not-call list must be loaded and fresh before any dial there
# (pnpm --filter @naaradh/workers dnc:load — docs/runbooks/dnc-registry.md). Empty = none required.
DND_REGISTRY_REGIONS=US,GB

# ---------------------------------------------------------------------------
# Regions (ADR-0012). Local and single-region deployments leave the peers empty: nothing is
# forwarded and no directory is pushed. REGION_PEERS maps each OTHER region to its hooks URL,
# e.g. {"us":"https://hooks.us.naaradh.com"}. Each region signs its directory snapshots with its
# own Ed25519 key (REGION_SYNC_PRIVATE_KEY, workers WORKER=reconcile) and verifies peers with
# their public keys (REGION_PEER_KEYS, hooks), e.g. {"us":"<base64 public key>"}. Generate a pair:
#   node --import tsx -e "import('@naaradh/shared').then(m=>console.log(m.generateRegionKeyPair()))"
# ---------------------------------------------------------------------------
REGION_PEERS=
REGION_SYNC_PRIVATE_KEY=
REGION_PEER_KEYS=

# ---------------------------------------------------------------------------
# Hooks (hooks). Per-shop Shopify secrets for custom apps as JSON; default is SHOPIFY_API_SECRET.
# ---------------------------------------------------------------------------
SHOPIFY_WEBHOOK_SECRETS={}
RATE_LIMIT_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Voice (voice, :3003) — inbound context + mid-call tools. Uses DATABASE_URL (app role
# only), REDIS_URL, PHONE_HASH_KEY, PHONE_ENC_PUBLIC_KEY, STAFF_ENC_PRIVATE_KEY,
# ENGINE_WEBHOOK_KEY, VOICE_BASE_URL, HOOKS_BASE_URL, ENGINE_MAX_CONCURRENCY.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# API (api)
# ---------------------------------------------------------------------------
RATE_LIMIT_KEY_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=10
DEFAULT_KEY_DAILY_CAP=5000

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
# Razorpay (direct Indian merchants, P2-BILL-3): api (subscribe) + workers WORKER=billing (add-ons, status).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# hooks: Razorpay dashboard → Webhooks secret. Unset → /razorpay/webhooks answers 404.
RAZORPAY_WEBHOOK_SECRET=
# api: plan combinations offered → Razorpay plan ids, e.g. {"growth+-":"plan_…","growth+inbound_growth":"plan_…"}
RAZORPAY_PLAN_IDS={}
# Stripe (direct USD merchants, P6-BILL-1): api + web (checkout) + workers WORKER=billing.
STRIPE_SECRET_KEY=
# hooks: Stripe dashboard → Webhooks signing secret (whsec_…). Unset → /stripe/webhooks answers 404.
STRIPE_WEBHOOK_SECRET=
# api + web: plan code → USD price id, e.g. {"growth":"price_…","inbound_growth":"price_…"}
STRIPE_PRICE_IDS={}

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Postmark server token (mail.naaradh.com). Unset locally: emails go to an in-memory outbox and
# the dashboard logs sign-in links in development. Required in production (web, workers
# notifications).
POSTMARK_TOKEN=
MAIL_FROM=Naaradh <no-reply@mail.naaradh.com>
# Merchant webhooks are signed with one secret PER endpoint, stored in Secret Manager and
# referenced by merchant_webhooks.secret_ref — there is no global signing key to set here.

# ---------------------------------------------------------------------------
# Merchant dashboard (web, :3000 — ADR-0009). App role only; refuses DATABASE_SERVICE_URL
# and private keys in production. Uses DATABASE_URL, REDIS_URL, PHONE_HASH_KEY,
# STAFF_ENC_PUBLIC_KEY, POSTMARK_TOKEN, RAZORPAY_*, STRIPE_SECRET_KEY, STRIPE_PRICE_IDS.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
# full = marketing pages + dashboard + sign-in + the public do-not-call form (what `pnpm dev`
# and Cloud Run run). marketing = only the pages that need no database, which is what the
# Vercel deployment serves (web/.env.example, go-live 11).
NAARADH_SURFACE=full
# dev = fake signed URLs; gcs = real (production default)
MEDIA_STORE=dev
# Links in merchant emails and the Shopify app point here.
DASHBOARD_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Staff console (console, :3004, behind IAP — ADR-0009). Service role.
# ---------------------------------------------------------------------------
CONSOLE_ORIGIN=http://localhost:3004
CONSOLE_ALLOWED_DOMAIN=naaradh.com
CONSOLE_STAFF_EMAILS=
# Local only: act as this staff user without IAP (refused in production).
CONSOLE_DEV_STAFF_EMAIL=
# Production: /projects/<number>/global/backendServices/<id> of the IAP backend.
IAP_AUDIENCE=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# There is no kill-switch variable: the global, engine, tenant and campaign switches live in
# Redis and are checked on every dispatch and every inbound admission (invariant 12). Flip them
# from the staff console — docs/runbooks/kill-switch.md.

# ---------------------------------------------------------------------------
# Local logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
NODE_ENV=development

# Nightly BigQuery export (WORKER=analytics, P2-INF-2). Unset locally → in-memory sink.
BIGQUERY_DATASET=
BIGQUERY_TABLE=daily_call_facts
BIGQUERY_LOCATION=

# Reverse proxies in front of the service (Cloud Run + external LB = 2). 0 locally: with a
# value the client IP is taken from X-Forwarded-For for rate limits and API-key allow-lists.
TRUST_PROXY_HOPS=0
# Production refuses ENGINE_DEFAULT_*=simulator unless this is true (staging), and refuses the
# shared development SIMULATOR_WEBHOOK_SECRET.
SIMULATOR_ALLOWED=false
